blueprint:
  name: Skylight Shade — Light, Weather, and Temperature
  description: >-
    Opens or closes a skylight shade using either an illuminance sensor or the
    current condition of a weather entity, together with indoor and outdoor
    temperatures in Fahrenheit. Strong light closes the shade when cooling is
    needed and opens it when solar gain or daylight is useful. Dim conditions can
    close the shade for nighttime insulation. Uses only open/close cover actions.
  domain: automation
  author: OpenAI Codex
  homeassistant:
    min_version: 2024.10.0
  input:
    entities:
      name: Entities
      icon: mdi:roller-shade
      input:
        shade_cover:
          name: Skylight shade
          description: Any cover entity that supports open and close actions.
          selector:
            entity:
              filter:
                - domain: cover
        indoor_temperature:
          name: Indoor temperature sensor (°F)
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: temperature
        outdoor_temperature:
          name: Outdoor temperature sensor (°F)
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: temperature
        light_or_weather_source:
          name: Illuminance or current-weather source
          description: >-
            Select either an illuminance sensor or a weather entity. Weather
            entities use their current condition: sunny and partly cloudy count
            as bright; other known conditions count as dim.
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: illuminance
                - domain: weather

    optional:
      name: Optional coordination
      icon: mdi:tune-variant
      collapsed: true
      input:
        climate_entity:
          name: HVAC climate entity
          description: Optional; active heating or cooling is included in demand detection.
          default: ""
          selector:
            entity:
              filter:
                - domain: climate
        automation_enabled:
          name: Automation-enable helper
          description: Optional input_boolean; off pauses the automation.
          default: ""
          selector:
            entity:
              filter:
                - domain: input_boolean
        manual_hold:
          name: Manual-hold helper
          description: Optional input_boolean; on preserves the manually selected shade state.
          default: ""
          selector:
            entity:
              filter:
                - domain: input_boolean
        additional_conditions:
          name: Additional conditions
          description: Optional occupancy, quiet-hours, or other conditions.
          default:
            - condition: template
              value_template: "{{ true }}"
          selector:
            condition:

    light_settings:
      name: Light settings
      icon: mdi:brightness-6
      input:
        bright_lux_threshold:
          name: Bright threshold
          description: Shade decisions enter bright mode at or above this value.
          default: 12000
          selector:
            number:
              min: 100
              max: 100000
              step: 100
              unit_of_measurement: lx
              mode: box
        dim_lux_threshold:
          name: Dim threshold
          description: Keep below the bright threshold to prevent cycling.
          default: 6000
          selector:
            number:
              min: 0
              max: 99000
              step: 100
              unit_of_measurement: lx
              mode: box
        close_when_dim:
          name: Close when dim
          description: Close after dark or in persistently dim weather.
          default: true
          selector:
            boolean:

    temperature_settings:
      name: Temperature settings — Fahrenheit
      icon: mdi:thermometer
      input:
        cooling_indoor_temperature:
          name: Indoor cooling threshold
          default: 76
          selector:
            number:
              min: 50
              max: 105
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        cooling_outdoor_temperature:
          name: Outdoor cooling threshold
          default: 78
          selector:
            number:
              min: 40
              max: 125
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        heating_indoor_temperature:
          name: Indoor heating threshold
          default: 68
          selector:
            number:
              min: 40
              max: 90
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        cold_outdoor_temperature:
          name: Cold outdoor threshold
          default: 45
          selector:
            number:
              min: -20
              max: 70
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        night_insulation_delta:
          name: Night insulation temperature difference
          description: Close when indoors is warmer than outdoors by at least this amount.
          default: 8
          selector:
            number:
              min: 1
              max: 40
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        enable_night_insulation:
          name: Enable cold-night insulation
          description: Most useful with insulating or cellular shades.
          default: true
          selector:
            boolean:

triggers:
  - trigger: state
    entity_id: !input indoor_temperature
  - trigger: state
    entity_id: !input outdoor_temperature
  - trigger: state
    entity_id: !input light_or_weather_source
  - trigger: time_pattern
    minutes: "/5"
  - trigger: homeassistant
    event: start

variables:
  shade: !input shade_cover
  indoor_sensor: !input indoor_temperature
  outdoor_sensor: !input outdoor_temperature
  environment_source: !input light_or_weather_source
  climate: !input climate_entity
  enabled_helper: !input automation_enabled
  hold_helper: !input manual_hold
  bright_threshold: !input bright_lux_threshold
  dim_threshold: !input dim_lux_threshold
  dim_close_enabled: !input close_when_dim
  cooling_indoor: !input cooling_indoor_temperature
  cooling_outdoor: !input cooling_outdoor_temperature
  heating_indoor: !input heating_indoor_temperature
  cold_outdoor: !input cold_outdoor_temperature
  insulation_delta: !input night_insulation_delta
  night_insulation_enabled: !input enable_night_insulation
  indoor: "{{ states(indoor_sensor) | float(none) }}"
  outdoor: "{{ states(outdoor_sensor) | float(none) }}"
  source_state: "{{ states(environment_source) }}"
  source_is_lux: "{{ environment_source.startswith('sensor.') }}"
  lux: "{{ source_state | float(none) if source_is_lux else none }}"
  source_available: "{{ source_state not in ['unknown', 'unavailable', 'none', ''] }}"
  bright: >-
    {{ source_available and
       ((source_is_lux and lux is number and lux >= bright_threshold) or
        (not source_is_lux and source_state in ['sunny', 'partlycloudy'])) }}
  dim: >-
    {{ source_available and
       ((source_is_lux and lux is number and lux <= dim_threshold) or
        (not source_is_lux and source_state not in ['sunny', 'partlycloudy'])) }}
  hvac_action: "{{ state_attr(climate, 'hvac_action') if climate else none }}"
  temperatures_valid: "{{ indoor is number and outdoor is number }}"
  cooling_needed: >-
    {{ temperatures_valid and
       (indoor >= cooling_indoor or outdoor >= cooling_outdoor or hvac_action == 'cooling') }}
  heating_useful: >-
    {{ temperatures_valid and
       (indoor <= heating_indoor or outdoor <= cold_outdoor or hvac_action == 'heating') }}
  cold_night: >-
    {{ temperatures_valid and outdoor <= cold_outdoor and
       (indoor - outdoor) >= insulation_delta }}
  automation_allowed: >-
    {{ (not enabled_helper or is_state(enabled_helper, 'on')) and
       (not hold_helper or is_state(hold_helper, 'off')) }}

conditions:
  - condition: template
    value_template: "{{ automation_allowed and temperatures_valid and source_available }}"
  - condition: and
    conditions: !input additional_conditions

actions:
  - choose:
      - alias: Block strong solar gain when cooling is needed
        conditions:
          - condition: template
            value_template: "{{ bright and cooling_needed and not is_state(shade, 'closed') }}"
        sequence:
          - action: cover.close_cover
            target:
              entity_id: "{{ shade }}"

      - alias: Admit daylight or useful solar heat
        conditions:
          - condition: template
            value_template: >-
              {{ bright and (heating_useful or not cooling_needed) and
                 not is_state(shade, 'open') }}
        sequence:
          - action: cover.open_cover
            target:
              entity_id: "{{ shade }}"

      - alias: Close for cold-night insulation
        conditions:
          - condition: template
            value_template: >-
              {{ dim and night_insulation_enabled and cold_night and
                 not is_state(shade, 'closed') }}
        sequence:
          - action: cover.close_cover
            target:
              entity_id: "{{ shade }}"

      - alias: Apply the selected dim-light preference
        conditions:
          - condition: template
            value_template: "{{ dim }}"
        sequence:
          - if:
              - condition: template
                value_template: "{{ dim_close_enabled }}"
            then:
              - condition: template
                value_template: "{{ not is_state(shade, 'closed') }}"
              - action: cover.close_cover
                target:
                  entity_id: "{{ shade }}"
            else:
              - condition: template
                value_template: "{{ not is_state(shade, 'open') }}"
              - action: cover.open_cover
                target:
                  entity_id: "{{ shade }}"

mode: restart
max_exceeded: silent

