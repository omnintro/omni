blueprint:
  name: Skylight Window — Light, Weather, and Temperature
  description: >-
    Opens an operable skylight when indoor air needs cooling, outdoor air is
    usefully cooler, the selected illuminance/current-weather rule passes, and
    precipitation safety passes. Closes when those conditions are lost. Accepts
    either a lux sensor or a weather entity for the light/weather decision and
    either a binary rain sensor or weather entity for precipitation protection.
    Uses only open/close cover actions and Fahrenheit temperatures.
  domain: automation
  author: OpenAI Codex
  homeassistant:
    min_version: 2024.10.0
  input:
    entities:
      name: Entities
      icon: mdi:window-open-variant
      input:
        skylight_cover:
          name: Operable skylight
          description: Any cover entity that supports open and close actions.
          selector:
            entity:
              filter:
                - domain: cover
        indoor_temperature:
          name: Indoor temperature sensor (°F)
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: temperature
        outdoor_temperature:
          name: Outdoor temperature sensor (°F)
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: temperature
        light_or_weather_source:
          name: Illuminance or current-weather source
          description: >-
            Select either an illuminance sensor or a weather entity. Sunny and
            partly cloudy weather count as bright; other known conditions count as dim.
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: illuminance
                - domain: weather

    safety:
      name: Precipitation and weather safety
      icon: mdi:weather-rainy
      input:
        precipitation_source:
          name: Rain or weather source
          description: >-
            Optional binary rain sensor (off=dry, on=wet) or weather entity. If
            left empty and the light source is a weather entity, that weather
            entity is reused. If no precipitation source is available, opening is
            blocked unless “allow opening without rain protection” is enabled.
          default: ""
          selector:
            entity:
              filter:
                - domain: binary_sensor
                - domain: weather
        allow_without_rain_protection:
          name: Allow opening without rain protection
          default: false
          selector:
            boolean:
        wind_speed:
          name: Wind-speed sensor
          description: Optional; unknown or excessive wind blocks opening and forces closure.
          default: ""
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: wind_speed
        maximum_wind_speed:
          name: Maximum safe wind speed
          description: Uses the selected sensor's native unit.
          default: 25
          selector:
            number:
              min: 1
              max: 150
              step: 1
              mode: box
        freeze_close_temperature:
          name: Freeze-protection temperature
          default: 35
          selector:
            number:
              min: -20
              max: 60
              step: 0.5
              unit_of_measurement: "°F"
              mode: box

    light_settings:
      name: Opening light/weather rule
      icon: mdi:brightness-6
      input:
        opening_light_rule:
          name: Open during
          description: Bright favors daytime ventilation; dim favors evening/night cooling.
          default: dim
          selector:
            select:
              options:
                - bright
                - dim
                - either
              mode: list
        bright_lux_threshold:
          name: Bright threshold
          default: 12000
          selector:
            number:
              min: 100
              max: 100000
              step: 100
              unit_of_measurement: lx
              mode: box
        dim_lux_threshold:
          name: Dim threshold
          description: Keep below the bright threshold to prevent cycling.
          default: 6000
          selector:
            number:
              min: 0
              max: 99000
              step: 100
              unit_of_measurement: lx
              mode: box

    temperature_settings:
      name: Temperature settings — Fahrenheit
      icon: mdi:thermometer
      input:
        indoor_open_temperature:
          name: Open above indoor temperature
          default: 75
          selector:
            number:
              min: 50
              max: 105
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        indoor_close_temperature:
          name: Close below indoor temperature
          description: Keep below the opening threshold to prevent cycling.
          default: 72
          selector:
            number:
              min: 40
              max: 100
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        required_opening_delta:
          name: Indoor-to-outdoor opening advantage
          description: Indoor air must be warmer than outdoor air by at least this amount.
          default: 4
          selector:
            number:
              min: 1
              max: 30
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        closing_delta:
          name: Close below indoor-to-outdoor advantage
          description: Keep below the opening advantage to prevent cycling.
          default: 1.5
          selector:
            number:
              min: 0
              max: 25
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        minimum_outdoor_temperature:
          name: Minimum outdoor opening temperature
          default: 50
          selector:
            number:
              min: -20
              max: 90
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        maximum_outdoor_temperature:
          name: Maximum outdoor opening temperature
          default: 82
          selector:
            number:
              min: 40
              max: 125
              step: 0.5
              unit_of_measurement: "°F"
              mode: box

    schedule_and_control:
      name: Schedule and optional coordination
      icon: mdi:clock-outline
      collapsed: true
      input:
        opening_start_time:
          name: Earliest opening time
          default: "06:00:00"
          selector:
            time:
        opening_end_time:
          name: Latest opening time
          default: "23:00:00"
          selector:
            time:
        climate_entity:
          name: HVAC climate entity
          description: Optional; the window closes while HVAC actively heats or cools.
          default: ""
          selector:
            entity:
              filter:
                - domain: climate
        automation_enabled:
          name: Automation-enable helper
          description: Optional input_boolean; off pauses efficiency moves, not safety closure.
          default: ""
          selector:
            entity:
              filter:
                - domain: input_boolean
        manual_hold:
          name: Manual-hold helper
          description: Optional input_boolean; on preserves manual state unless unsafe.
          default: ""
          selector:
            entity:
              filter:
                - domain: input_boolean
        additional_open_conditions:
          name: Additional opening conditions
          description: Optional occupancy, alarm, or other conditions.
          default:
            - condition: template
              value_template: "{{ true }}"
          selector:
            condition:

triggers:
  - trigger: state
    entity_id: !input indoor_temperature
  - trigger: state
    entity_id: !input outdoor_temperature
  - trigger: state
    entity_id: !input light_or_weather_source
  - trigger: time_pattern
    minutes: "/5"
  - trigger: homeassistant
    event: start
  - trigger: template
    value_template: >-
      {% set wet = ['rainy', 'pouring', 'lightning', 'lightning-rainy',
                    'snowy', 'snowy-rainy', 'hail', 'exceptional'] %}
      {% if precipitation_source_trigger.startswith('binary_sensor.') %}
        {{ not is_state(precipitation_source_trigger, 'off') }}
      {% elif precipitation_source_trigger.startswith('weather.') %}
        {{ states(precipitation_source_trigger) in wet or
           states(precipitation_source_trigger) in ['unknown', 'unavailable'] }}
      {% else %}
        {{ false }}
      {% endif %}
  - trigger: template
    value_template: >-
      {{ wind_source_trigger != '' and
         (states(wind_source_trigger) in ['unknown', 'unavailable'] or
          states(wind_source_trigger) | float(-1) >= wind_limit_trigger | float) }}
  - trigger: template
    value_template: >-
      {{ climate_source_trigger != '' and
         state_attr(climate_source_trigger, 'hvac_action') in ['heating', 'cooling'] }}

trigger_variables:
  precipitation_source_trigger: !input precipitation_source
  wind_source_trigger: !input wind_speed
  wind_limit_trigger: !input maximum_wind_speed
  climate_source_trigger: !input climate_entity

variables:
  skylight: !input skylight_cover
  indoor_sensor: !input indoor_temperature
  outdoor_sensor: !input outdoor_temperature
  environment_source: !input light_or_weather_source
  selected_precipitation_source: !input precipitation_source
  allow_without_rain: !input allow_without_rain_protection
  wind_entity: !input wind_speed
  wind_limit: !input maximum_wind_speed
  freeze_temperature: !input freeze_close_temperature
  light_rule: !input opening_light_rule
  bright_threshold: !input bright_lux_threshold
  dim_threshold: !input dim_lux_threshold
  open_temperature: !input indoor_open_temperature
  close_temperature: !input indoor_close_temperature
  open_delta: !input required_opening_delta
  close_delta: !input closing_delta
  minimum_outdoor: !input minimum_outdoor_temperature
  maximum_outdoor: !input maximum_outdoor_temperature
  start_time: !input opening_start_time
  end_time: !input opening_end_time
  climate: !input climate_entity
  enabled_helper: !input automation_enabled
  hold_helper: !input manual_hold
  indoor: "{{ states(indoor_sensor) | float(none) }}"
  outdoor: "{{ states(outdoor_sensor) | float(none) }}"
  source_state: "{{ states(environment_source) }}"
  source_is_lux: "{{ environment_source.startswith('sensor.') }}"
  source_is_weather: "{{ environment_source.startswith('weather.') }}"
  lux: "{{ source_state | float(none) if source_is_lux else none }}"
  source_available: "{{ source_state not in ['unknown', 'unavailable', 'none', ''] }}"
  bright: >-
    {{ source_available and
       ((source_is_lux and lux is number and lux >= bright_threshold) or
        (source_is_weather and source_state in ['sunny', 'partlycloudy'])) }}
  dim: >-
    {{ source_available and
       ((source_is_lux and lux is number and lux <= dim_threshold) or
        (source_is_weather and source_state not in ['sunny', 'partlycloudy'])) }}
  light_rule_passes: >-
    {{ source_available and
       (light_rule == 'either' or (light_rule == 'bright' and bright) or
        (light_rule == 'dim' and dim)) }}
  light_close_required: >-
    {{ (light_rule == 'bright' and dim) or (light_rule == 'dim' and bright) }}
  precipitation_entity: >-
    {{ selected_precipitation_source if selected_precipitation_source else
       (environment_source if source_is_weather else '') }}
  wet_weather_states:
    - rainy
    - pouring
    - lightning
    - lightning-rainy
    - snowy
    - snowy-rainy
    - hail
    - exceptional
  rain_safe: >-
    {% if not precipitation_entity %}
      {{ allow_without_rain }}
    {% elif precipitation_entity.startswith('binary_sensor.') %}
      {{ is_state(precipitation_entity, 'off') }}
    {% else %}
      {{ states(precipitation_entity) not in wet_weather_states and
         states(precipitation_entity) not in ['unknown', 'unavailable'] }}
    {% endif %}
  wind: "{{ states(wind_entity) | float(none) if wind_entity else none }}"
  wind_safe: "{{ not wind_entity or (wind is number and wind < wind_limit) }}"
  temperatures_valid: "{{ indoor is number and outdoor is number }}"
  freeze_safe: "{{ outdoor is number and outdoor > freeze_temperature }}"
  hvac_action: "{{ state_attr(climate, 'hvac_action') if climate else none }}"
  hvac_idle: "{{ not climate or hvac_action not in ['heating', 'cooling'] }}"
  automation_allowed: >-
    {{ (not enabled_helper or is_state(enabled_helper, 'on')) and
       (not hold_helper or is_state(hold_helper, 'off')) }}
  within_schedule: >-
    {% set start = today_at(start_time) %}
    {% set end = today_at(end_time) %}
    {% if start <= end %}
      {{ start <= now() <= end }}
    {% else %}
      {{ now() >= start or now() <= end }}
    {% endif %}
  safety_close: >-
    {{ not temperatures_valid or not rain_safe or not wind_safe or not freeze_safe }}
  should_open: >-
    {{ temperatures_valid and automation_allowed and rain_safe and wind_safe and freeze_safe
       and hvac_idle and within_schedule and light_rule_passes
       and indoor >= open_temperature
       and outdoor >= minimum_outdoor and outdoor <= maximum_outdoor
       and (indoor - outdoor) >= open_delta }}
  should_efficiency_close: >-
    {{ automation_allowed and
       (not hvac_idle or not within_schedule or light_close_required
        or indoor <= close_temperature or outdoor < minimum_outdoor
        or outdoor > maximum_outdoor or (indoor - outdoor) <= close_delta) }}

conditions: []

actions:
  - choose:
      - alias: Safety closure
        conditions:
          - condition: template
            value_template: "{{ safety_close and not is_state(skylight, 'closed') }}"
        sequence:
          - action: cover.close_cover
            target:
              entity_id: "{{ skylight }}"

      - alias: Close when opening conditions are lost
        conditions:
          - condition: template
            value_template: >-
              {{ should_efficiency_close and not is_state(skylight, 'closed') }}
        sequence:
          - action: cover.close_cover
            target:
              entity_id: "{{ skylight }}"

      - alias: Open for natural cooling
        conditions:
          - condition: template
            value_template: "{{ should_open and not is_state(skylight, 'open') }}"
          - condition: and
            conditions: !input additional_open_conditions
        sequence:
          - action: cover.open_cover
            target:
              entity_id: "{{ skylight }}"

mode: restart
max_exceeded: silent
