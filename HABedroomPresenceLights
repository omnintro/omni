blueprint:
  name: Presence Lighting with Inovelli Manual-Off Lockout (Zigbee + Matter)
  description: >
    Presence-based lighting that respects a physical Inovelli OFF command.

    When the configured Inovelli OFF/down-paddle trigger fires, this automation
    immediately enables a persistent manual-off lockout and turns the controlled
    load(s) off.

    While that lockout is enabled, presence ABSOLUTELY CANNOT turn the
    controlled load(s) back on.

    The lockout is cleared ONLY by the configured Inovelli ON/up-paddle trigger.

    Supports:
      - Inovelli Zigbee device triggers
      - Inovelli Matter event entities
      - light.* entities
      - switch.* entities, including Matter on/off switches

    A dedicated input_boolean helper is required to store the manual-off
    lockout state.

  domain: automation

  homeassistant:
    min_version: 2024.10.0

  input:

    presence_sensors:
      name: Presence sensors
      description: >
        Select one or more motion, occupancy, or presence binary sensors.

        Presence may turn the controlled load(s) on ONLY when the
        manual-off lockout helper is OFF.
      selector:
        entity:
          multiple: true
          filter:
            - domain: binary_sensor
              device_class:
                - motion
                - occupancy
                - presence


    controlled_loads:
      name: Lights / switches to control
      description: >
        Select the lighting loads controlled by presence.

        Both light.* and switch.* entities are supported.

        Inovelli Zigbee dimmers commonly appear as light.* entities.
        Inovelli Matter on/off switches may appear as switch.* entities.
      selector:
        target:
          entity:
            domain:
              - light
              - switch


    manual_lockout:
      name: Manual-off lockout helper
      description: >
        Select a dedicated Toggle helper (input_boolean) for this room.

        OFF = Presence lighting is permitted.

        ON = Someone physically turned the lights off from the Inovelli
        switch and presence lighting is forbidden from turning them on.

        This helper is cleared ONLY by the physical Inovelli ON trigger.
      selector:
        entity:
          filter:
            - domain: input_boolean


    inovelli_off_triggers:
      name: Inovelli physical OFF / Down Paddle trigger(s)
      description: >
        Configure the physical action that means the user intentionally
        turned the lighting OFF.

        ZIGBEE:
        Select the Inovelli device trigger corresponding to a single press
        of the DOWN paddle.

        MATTER:
        Add a STATE trigger using the switch's event.*_down entity.

        IMPORTANT FOR MATTER:
        Leave From, To, and Attribute blank.

        The blueprint checks event_type itself. This allows consecutive
        single presses to work correctly.
      selector:
        trigger:


    inovelli_on_triggers:
      name: Inovelli physical ON / Up Paddle trigger(s)
      description: >
        Configure the physical action that means the user intentionally
        turned the lighting ON.

        ZIGBEE:
        Select the Inovelli device trigger corresponding to a single press
        of the UP paddle.

        MATTER:
        Add a STATE trigger using the switch's event.*_up entity.

        IMPORTANT FOR MATTER:
        Leave From, To, and Attribute blank.

        THIS IS THE ONLY TRIGGER GROUP THAT CLEARS THE MANUAL-OFF LOCKOUT.
      selector:
        trigger:


    matter_single_press_event_type:
      name: Matter single-press event type
      description: >
        The event_type Home Assistant reports for a single paddle press
        on an Inovelli Matter switch.

        Current Inovelli Matter switches normally use:

        multi_press_1

        You should normally leave this unchanged.
      default: multi_press_1
      selector:
        text:


    no_presence_delay:
      name: No-presence turn-off delay
      description: >
        How long a presence sensor must remain clear before the automation
        checks that ALL selected presence sensors are clear and turns the
        lighting off.
      default:
        minutes: 2
      selector:
        duration:


# ======================================================================
# VARIABLES
# ======================================================================

variables:

  presence_entities: !input presence_sensors

  configured_off_triggers: !input inovelli_off_triggers

  configured_on_triggers: !input inovelli_on_triggers

  matter_single_press_type: !input matter_single_press_event_type


# ======================================================================
# TRIGGERS
# ======================================================================

triggers:

  # --------------------------------------------------------------------
  # INOVELLI OFF TRIGGERS
  #
  # These may be:
  #   - Zigbee device triggers
  #   - Matter event.*_down state triggers
  #
  # Home Assistant flattens this trigger list.
  # --------------------------------------------------------------------

  - triggers: !input inovelli_off_triggers


  # --------------------------------------------------------------------
  # INOVELLI ON TRIGGERS
  #
  # These may be:
  #   - Zigbee device triggers
  #   - Matter event.*_up state triggers
  # --------------------------------------------------------------------

  - triggers: !input inovelli_on_triggers


  # --------------------------------------------------------------------
  # PRESENCE DETECTED
  # --------------------------------------------------------------------

  - trigger: state
    entity_id: !input presence_sensors
    to: "on"
    id: presence_on


  # --------------------------------------------------------------------
  # PRESENCE CLEARED
  # --------------------------------------------------------------------

  - trigger: state
    entity_id: !input presence_sensors
    to: "off"
    for: !input no_presence_delay
    id: presence_off


# ======================================================================
# ACTIONS
# ======================================================================

actions:

  - choose:


      # ================================================================
      # PHYSICAL INOVELLI OFF
      #
      # MOST IMPORTANT PART OF THE BLUEPRINT:
      #
      # 1. Engage the lockout FIRST.
      # 2. Turn the lighting OFF.
      #
      # Once the helper is ON, presence cannot reach a turn_on action.
      # ================================================================

      - alias: Inovelli physical OFF - engage manual lockout

        conditions:

          # ------------------------------------------------------------
          # Determine whether this trigger came from the OFF trigger list.
          #
          # trigger.idx is the flattened trigger's index.
          # All OFF triggers are first in the complete trigger list.
          # ------------------------------------------------------------

          - condition: template
            alias: Trigger came from configured OFF trigger group
            value_template: >
              {% set i = trigger.idx | int(-1) %}
              {% set off_count = configured_off_triggers | count %}

              {{ i >= 0 and i < off_count }}


          # ------------------------------------------------------------
          # MATTER EVENT FILTER
          #
          # Matter event entities fire whenever that paddle generates an
          # event. We only want a normal single press to count as the
          # standard OFF action.
          #
          # Zigbee device triggers aren't event.* state entities, so they
          # automatically pass this condition.
          # ------------------------------------------------------------

          - condition: template
            alias: Matter event is single press or trigger is not Matter event entity
            value_template: >
              {% if
                    trigger.platform == 'state'
                    and trigger.to_state is not none
                    and trigger.to_state.entity_id.startswith('event.')
              %}

                {{
                  trigger.to_state.attributes.get('event_type', '')
                  ==
                  matter_single_press_type
                }}

              {% else %}

                true

              {% endif %}


        sequence:

          # ------------------------------------------------------------
          # CRITICAL:
          # Engage lockout BEFORE doing anything with the controlled load.
          # ------------------------------------------------------------

          - alias: Engage manual-off lockout
            action: input_boolean.turn_on
            target:
              entity_id: !input manual_lockout


          # ------------------------------------------------------------
          # Generic Home Assistant action supports light.* AND switch.*
          # ------------------------------------------------------------

          - alias: Turn controlled lighting OFF
            action: homeassistant.turn_off
            target: !input controlled_loads



      # ================================================================
      # PHYSICAL INOVELLI ON
      #
      # This is intentionally the ONLY branch anywhere in this blueprint
      # that clears the lockout helper.
      # ================================================================

      - alias: Inovelli physical ON - clear manual lockout

        conditions:

          # ------------------------------------------------------------
          # Determine whether this trigger came from the ON trigger list.
          # ------------------------------------------------------------

          - condition: template
            alias: Trigger came from configured ON trigger group
            value_template: >
              {% set i = trigger.idx | int(-1) %}

              {% set off_count =
                   configured_off_triggers | count %}

              {% set on_count =
                   configured_on_triggers | count %}

              {{
                i >= off_count
                and
                i < (off_count + on_count)
              }}


          # ------------------------------------------------------------
          # Matter event entity single-press filter.
          # ------------------------------------------------------------

          - condition: template
            alias: Matter event is single press or trigger is not Matter event entity
            value_template: >
              {% if
                    trigger.platform == 'state'
                    and trigger.to_state is not none
                    and trigger.to_state.entity_id.startswith('event.')
              %}

                {{
                  trigger.to_state.attributes.get('event_type', '')
                  ==
                  matter_single_press_type
                }}

              {% else %}

                true

              {% endif %}


        sequence:

          # ------------------------------------------------------------
          # ONLY PLACE THE LOCKOUT IS CLEARED
          # ------------------------------------------------------------

          - alias: Clear manual-off lockout
            action: input_boolean.turn_off
            target:
              entity_id: !input manual_lockout


          # ------------------------------------------------------------
          # Physical UP is treated as an explicit request to turn the
          # room lighting on.
          #
          # Generic action works with light.* and switch.*.
          # ------------------------------------------------------------

          - alias: Turn controlled lighting ON
            action: homeassistant.turn_on
            target: !input controlled_loads



      # ================================================================
      # PRESENCE DETECTED
      #
      # THIS IS THE HARD LOCKOUT.
      #
      # The turn_on action below cannot execute unless manual_lockout
      # is OFF.
      # ================================================================

      - alias: Presence detected - turn on only when authorized

        conditions:

          - condition: trigger
            id: presence_on


          # ------------------------------------------------------------
          # ABSOLUTE PRESENCE LOCKOUT
          #
          # If someone pressed DOWN on the Inovelli switch:
          #
          # manual_lockout = ON
          #
          # Therefore this condition fails.
          #
          # Therefore homeassistant.turn_on below is unreachable.
          # ------------------------------------------------------------

          - condition: state
            entity_id: !input manual_lockout
            state: "off"


        sequence:

          - alias: Presence authorized - turn lighting ON
            action: homeassistant.turn_on
            target: !input controlled_loads



      # ================================================================
      # PRESENCE CLEARED
      #
      # Turning lighting off automatically does NOT alter the lockout.
      #
      # Automatic OFF:
      #   Does not enable lockout.
      #   Does not disable lockout.
      #
      # Only physical Inovelli paddle actions change the lockout.
      # ================================================================

      - alias: All presence clear - turn lighting OFF

        conditions:

          - condition: trigger
            id: presence_off


          # ------------------------------------------------------------
          # If several presence sensors are selected, one sensor's timer
          # may expire while another sensor still detects presence.
          #
          # Make sure every sensor is actually OFF.
          # ------------------------------------------------------------

          - condition: template
            alias: Every selected presence sensor is OFF
            value_template: >
              {% set sensors = expand(presence_entities) %}

              {{
                sensors | count > 0
                and
                (
                  sensors
                  | selectattr('state', 'eq', 'off')
                  | list
                  | count
                )
                ==
                (sensors | count)
              }}


        sequence:

          - alias: Turn controlled lighting OFF
            action: homeassistant.turn_off
            target: !input controlled_loads


# ======================================================================
# EXECUTION MODE
#
# Queue events instead of allowing simultaneous automation runs.
#
# Example:
#
#   Person presses DOWN
#   Presence sensor reports movement 50 ms later
#
# Processing order:
#
#   1. DOWN event
#   2. lockout helper -> ON
#   3. lights -> OFF
#   4. presence event processes
#   5. lockout condition fails
#   6. lights remain OFF
#
# ======================================================================

mode: queued
max: 20
max_exceeded: silent
