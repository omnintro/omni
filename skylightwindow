blueprint:
  name: Skylight Window — Safe Seasonal Ventilation
  description: >-
    Manages an operable skylight as a cover. Current or forecast rain, unavailable
    precipitation data, excessive wind, and freezing temperatures force it closed. When safe,
    the skylight opens for free cooling only when outdoor air is useful and the
    HVAC is not actively heating or cooling. A manual-hold helper can pause all
    comfort/efficiency moves while safety closure remains active.
  domain: automation
  author: OpenAI Codex
  homeassistant:
    min_version: 2024.10.0
  input:
    required:
      name: Required entities
      icon: mdi:window-open-variant
      input:
        skylight_cover:
          name: Operable skylight
          description: A cover entity that supports setting its position.
          selector:
            entity:
              filter:
                - domain: cover
                  supported_features:
                    - cover.CoverEntityFeature.SET_POSITION
        indoor_temperature:
          name: Indoor temperature
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: temperature
        outdoor_temperature:
          name: Outdoor temperature
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: temperature
        rain_sensor:
          name: Rain or weather source
          description: >-
            Select either a binary sensor (off=dry, on=wet) or a weather entity
            that supports hourly forecasts. Unknown, unavailable, or a failed
            hourly forecast is treated as unsafe.
          selector:
            entity:
              filter:
                - domain:
                    - binary_sensor
                    - weather

    optional:
      name: Optional coordination and safety
      icon: mdi:shield-home
      collapsed: true
      input:
        wind_speed:
          name: Wind-speed sensor
          description: Optional. Leave empty if unavailable.
          default: ""
          selector:
            entity:
              filter:
                - domain: sensor
                  device_class: wind_speed
        climate_entity:
          name: HVAC climate entity
          description: >-
            Optional. Prevents the skylight from opening while HVAC is actively
            heating or cooling and closes it if HVAC starts.
          default: ""
          selector:
            entity:
              filter:
                - domain: climate
        automation_enabled:
          name: Automation enable helper
          description: Optional input_boolean. Off pauses efficiency moves, not safety closure.
          default: ""
          selector:
            entity:
              filter:
                - domain: input_boolean
        manual_hold:
          name: Manual-hold helper
          description: Optional input_boolean. On preserves the user's position unless unsafe.
          default: ""
          selector:
            entity:
              filter:
                - domain: input_boolean
        additional_open_conditions:
          name: Additional opening conditions
          description: Optional occupancy, alarm, air-quality, or other conditions.
          default:
            - condition: template
              value_template: "{{ true }}"
          selector:
            condition:

    ventilation:
      name: Ventilation tuning
      icon: mdi:weather-windy
      description: >-
        All temperature values and differences are in °F.
      input:
        open_position:
          name: Ventilation opening
          default: 30
          selector:
            number:
              min: 5
              max: 100
              step: 5
              unit_of_measurement: "%"
        indoor_open_temperature:
          name: Open above indoor temperature (°F)
          default: 75
          selector:
            number:
              min: 50
              max: 105
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        indoor_close_temperature:
          name: Close below indoor temperature (°F)
          description: Set lower than the opening threshold to create hysteresis.
          default: 72.5
          selector:
            number:
              min: 40
              max: 105
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        required_cooling_delta:
          name: Minimum indoor-to-outdoor advantage (°F)
          description: Indoor air must be this much warmer than outdoor air before opening.
          default: 3.5
          selector:
            number:
              min: 1
              max: 18
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        close_delta:
          name: Close when temperature advantage falls below (°F)
          description: Set lower than the opening delta to reduce cycling.
          default: 1
          selector:
            number:
              min: 0
              max: 16
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        minimum_venting_temperature:
          name: Minimum outdoor ventilation temperature (°F)
          default: 50
          selector:
            number:
              min: -10
              max: 90
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        maximum_venting_temperature:
          name: Maximum outdoor ventilation temperature (°F)
          default: 82.5
          selector:
            number:
              min: 50
              max: 125
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        vent_start_time:
          name: Earliest opening time
          default: "06:00:00"
          selector:
            time:
        vent_end_time:
          name: Latest opening time
          default: "22:00:00"
          selector:
            time:

    safety:
      name: Safety limits
      icon: mdi:alert-octagon-outline
      description: Temperatures are in °F; wind uses the sensor's native unit.
      input:
        freeze_close_temperature:
          name: Freeze-protection close temperature (°F)
          description: Outdoor temperature at or below which the skylight is forced closed.
          default: 35.5
          selector:
            number:
              min: -10
              max: 60
              step: 0.5
              unit_of_measurement: "°F"
              mode: box
        maximum_wind_speed:
          name: Maximum safe wind speed
          description: Uses the native unit of the selected wind sensor.
          default: 35
          selector:
            number:
              min: 1
              max: 150
              step: 1
              mode: box
        forecast_hours:
          name: Forecast rain look-ahead
          description: Used only when the rain source is a weather entity.
          default: 2
          selector:
            number:
              min: 1
              max: 6
              step: 1
              unit_of_measurement: h
        precipitation_probability:
          name: Forecast precipitation-probability limit
          description: At or above this value, the skylight remains closed.
          default: 30
          selector:
            number:
              min: 0
              max: 100
              step: 5
              unit_of_measurement: "%"

triggers:
  - trigger: state
    entity_id: !input rain_sensor
    id: safety
  - trigger: state
    entity_id: !input indoor_temperature
    id: evaluate
  - trigger: state
    entity_id: !input outdoor_temperature
    id: evaluate
  - trigger: time_pattern
    minutes: "/5"
    id: evaluate
  - trigger: homeassistant
    event: start
    id: evaluate
  - trigger: template
    value_template: >-
      {{ wind_entity_trigger != '' and
         (states(wind_entity_trigger) in ['unknown', 'unavailable'] or
          states(wind_entity_trigger) | float(-1) >= wind_limit_trigger | float) }}
    id: safety
  - trigger: template
    value_template: >-
      {{ climate_entity_trigger != '' and
         state_attr(climate_entity_trigger, 'hvac_action') in ['heating', 'cooling'] }}
    id: evaluate
  - trigger: template
    value_template: >-
      {{ climate_entity_trigger != '' and
         state_attr(climate_entity_trigger, 'hvac_action') not in ['heating', 'cooling'] }}
    id: evaluate

trigger_variables:
  wind_entity_trigger: !input wind_speed
  wind_limit_trigger: !input maximum_wind_speed
  climate_entity_trigger: !input climate_entity

variables:
  skylight: !input skylight_cover
  indoor_sensor: !input indoor_temperature
  outdoor_sensor: !input outdoor_temperature
  rain_entity: !input rain_sensor
  wind_entity: !input wind_speed
  climate: !input climate_entity
  enabled_helper: !input automation_enabled
  hold_helper: !input manual_hold
  target_open_position: !input open_position
  open_temp: !input indoor_open_temperature
  close_temp: !input indoor_close_temperature
  open_delta: !input required_cooling_delta
  stop_delta: !input close_delta
  min_vent_temp: !input minimum_venting_temperature
  max_vent_temp: !input maximum_venting_temperature
  freeze_temp: !input freeze_close_temperature
  wind_limit: !input maximum_wind_speed
  rain_forecast_hours: !input forecast_hours
  rain_probability_limit: !input precipitation_probability
  vent_start: !input vent_start_time
  vent_end: !input vent_end_time
  indoor_raw: "{{ states(indoor_sensor) }}"
  outdoor_raw: "{{ states(outdoor_sensor) }}"
  indoor: "{{ indoor_raw | float(none) }}"
  outdoor: "{{ outdoor_raw | float(none) }}"
  wind_raw: "{{ states(wind_entity) if wind_entity else 'unknown' }}"
  wind: "{{ wind_raw | float(none) }}"
  hvac_action: "{{ state_attr(climate, 'hvac_action') if climate else none }}"
  current_position: "{{ state_attr(skylight, 'current_position') | int(-1) }}"
  sensors_valid: "{{ indoor is number and outdoor is number }}"
  rain_source_is_weather: "{{ rain_entity.startswith('weather.') }}"
  rain_safe: >-
    {{ is_state(rain_entity, 'off') if not rain_source_is_weather else
       states(rain_entity) not in
       ['unknown', 'unavailable', 'rainy', 'pouring', 'lightning-rainy',
        'snowy', 'snowy-rainy', 'hail', 'lightning', 'exceptional'] }}
  wind_safe: "{{ not wind_entity or (wind is number and wind < wind_limit) }}"
  freeze_safe: "{{ outdoor is number and outdoor > freeze_temp }}"
  safety_close: "{{ not rain_safe or not wind_safe or not freeze_safe }}"
  automation_allowed: >-
    {{ (not enabled_helper or is_state(enabled_helper, 'on'))
       and (not hold_helper or is_state(hold_helper, 'off')) }}
  hvac_idle: "{{ not climate or hvac_action not in ['heating', 'cooling'] }}"
  within_hours: >-
    {% set start = today_at(vent_start) %}
    {% set end = today_at(vent_end) %}
    {% if start <= end %}
      {{ start <= now() <= end }}
    {% else %}
      {{ now() >= start or now() <= end }}
    {% endif %}
  should_open: >-
    {{ sensors_valid and automation_allowed and rain_safe and wind_safe and freeze_safe
       and hvac_idle and within_hours
       and indoor >= open_temp
       and outdoor >= min_vent_temp and outdoor <= max_vent_temp
       and (indoor - outdoor) >= open_delta }}
  should_energy_close: >-
    {{ automation_allowed and
       (not sensors_valid or not within_hours or not hvac_idle
        or indoor <= close_temp or outdoor < min_vent_temp
        or outdoor > max_vent_temp or (indoor - outdoor) <= stop_delta) }}
  is_closed: "{{ is_state(skylight, 'closed') or current_position == 0 }}"
  is_at_open_target: >-
    {{ current_position >= 0 and
       (current_position - (target_open_position | int)) | abs <= 2 }}

conditions: []

actions:
  - choose:
      - alias: Evaluate current conditions and hourly forecast from a weather entity
        conditions:
          - condition: template
            value_template: "{{ rain_source_is_weather }}"
        sequence:
          - action: weather.get_forecasts
            target:
              entity_id: "{{ rain_entity }}"
            data:
              type: hourly
            response_variable: rain_forecast_response
            continue_on_error: true
          - variables:
              rain_safe: >-
                {% set wet = ['rainy', 'pouring', 'lightning-rainy', 'snowy',
                              'snowy-rainy', 'hail', 'lightning', 'exceptional'] %}
                {% set current_safe = states(rain_entity) not in
                   ['unknown', 'unavailable', 'rainy', 'pouring', 'lightning-rainy',
                    'snowy', 'snowy-rainy', 'hail', 'lightning', 'exceptional'] %}
                {% set entries = rain_forecast_response.get(rain_entity, {}).get('forecast', [])
                   if rain_forecast_response is defined else [] %}
                {% set ns = namespace(forecast_wet=false) %}
                {% for item in entries[:rain_forecast_hours | int] %}
                  {% if item.get('condition', 'unknown') in wet
                     or item.get('precipitation_probability', 0) | float(0) >= rain_probability_limit
                     or item.get('precipitation', 0) | float(0) > 0 %}
                    {% set ns.forecast_wet = true %}
                  {% endif %}
                {% endfor %}
                {{ current_safe and entries | length > 0 and not ns.forecast_wet }}
              safety_close: "{{ not rain_safe or not wind_safe or not freeze_safe }}"
              should_open: >-
                {{ sensors_valid and automation_allowed and rain_safe and wind_safe and freeze_safe
                   and hvac_idle and within_hours and indoor >= open_temp
                   and outdoor >= min_vent_temp and outdoor <= max_vent_temp
                   and (indoor - outdoor) >= open_delta }}
          - choose:
              - alias: Safety always wins
                conditions:
                  - condition: template
                    value_template: "{{ safety_close and not is_closed }}"
                sequence:
                  - action: cover.close_cover
                    target:
                      entity_id: "{{ skylight }}"
              - alias: Close when free cooling is no longer useful
                conditions:
                  - condition: template
                    value_template: "{{ should_energy_close and not is_closed }}"
                sequence:
                  - action: cover.close_cover
                    target:
                      entity_id: "{{ skylight }}"
              - alias: Open for useful natural cooling
                conditions:
                  - condition: template
                    value_template: "{{ should_open and not is_at_open_target }}"
                  - condition: and
                    conditions: !input additional_open_conditions
                sequence:
                  - action: cover.set_cover_position
                    target:
                      entity_id: "{{ skylight }}"
                    data:
                      position: "{{ target_open_position | int }}"
    default:
      - choose:
          - alias: Safety always wins
            conditions:
              - condition: template
                value_template: "{{ safety_close and not is_closed }}"
            sequence:
              - action: cover.close_cover
                target:
                  entity_id: "{{ skylight }}"
          - alias: Close when free cooling is no longer useful
            conditions:
              - condition: template
                value_template: "{{ should_energy_close and not is_closed }}"
            sequence:
              - action: cover.close_cover
                target:
                  entity_id: "{{ skylight }}"
          - alias: Open for useful natural cooling
            conditions:
              - condition: template
                value_template: "{{ should_open and not is_at_open_target }}"
              - condition: and
                conditions: !input additional_open_conditions
            sequence:
              - action: cover.set_cover_position
                target:
                  entity_id: "{{ skylight }}"
                data:
                  position: "{{ target_open_position | int }}"

mode: restart
max_exceeded: silent
