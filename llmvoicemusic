blueprint:
  name: Smooth Music Assistant LLM voice requests
  description: >-
    Creates a script that an LLM conversation agent can call to play music through
    Music Assistant. The script validates the request, resolves Music Assistant
    players from entity IDs or friendly names, resolves areas from IDs or names,
    falls back to a configured default player only when no target was requested,
    and returns structured success or failure information.

    After creating the script, give it a clear name and expose it to Assist.
    Suggested script description: "Play music with Music Assistant. Use this tool
    for requests to play a track, album, artist, playlist, or radio station. Supply
    media_type and media_id. Supply area and/or media_player only when the user names
    a destination. Set shuffle true only when the user explicitly asks for shuffle."
    Based on the Music Assistant voice-support LLM script blueprint:
    https://github.com/music-assistant/voice-support/blob/main/llm-script-blueprint/llm_voice_script.yaml
  domain: script
  author: Improved from the Music Assistant voice-support blueprint
  homeassistant:
    min_version: 2024.12.0
  input:
    playback_settings:
      name: Playback settings
      icon: mdi:music
      input:
        default_player:
          name: Default Music Assistant player
          description: >-
            Used only when the request supplies no area and no player. Leave empty
            to make the assistant ask where to play instead.
          default:
          selector:
            entity:
              filter:
                - integration: music_assistant
                  domain: media_player
              multiple: false
        enqueue_mode:
          name: Queue behavior
          description: >-
            "Replace" is the most predictable behavior for a new voice request.
          default: replace
          selector:
            select:
              options:
                - label: Replace the queue and play
                  value: replace
                - label: Play now without clearing the queue
                  value: play
                - label: Insert next
                  value: next
                - label: Replace upcoming items
                  value: replace_next
                - label: Add to the end
                  value: add
              mode: dropdown
        play_continuously:
          name: Radio mode
          description: >-
            Radio mode asks Music Assistant to continue with similar tracks. It is
            available only for supported providers and is never applied to a radio
            station request.
          default: Use player settings
          selector:
            select:
              options:
                - Use player settings
                - Always
                - Never
              mode: dropdown
        manage_shuffle:
          name: Manage shuffle
          description: >-
            When enabled, every request explicitly sets shuffle on or off after the
            new queue is loaded. Disable this if a player does not support shuffle or
            if you want its existing shuffle state left alone.
          default: true
          selector:
            boolean:

    prompt_settings:
      name: LLM field guidance
      icon: mdi:robot
      collapsed: true
      input:
        media_type_prompt:
          name: Media type guidance
          default: >-
            Required. Return exactly one of: track, album, artist, playlist, radio.
            Use track for a named song, several songs, a genre, mood, era, activity,
            or any open-ended music request. Use album only for a named album, artist
            for an artist catalog, playlist only for a named playlist, and radio only
            for a named live radio station or stream.
          selector:
            text:
              multiline: true
        media_id_prompt:
          name: Media ID guidance
          default: >-
            Required. Return the name or URI Music Assistant should search for. For
            several items, separate values with semicolons. For tracks by different
            artists use "Artist - Track" for each value. For a genre, mood, era,
            activity, or "best songs" request, choose up to five well-known, concrete
            tracks that accurately fit; never fabricate titles. Preserve spelling,
            punctuation, and provider URIs. Do not include playback verbs or the
            target room/player.
          selector:
            text:
              multiline: true
        artist_prompt:
          name: Artist guidance
          default: >-
            Optional. For a track or album request, return the artist only when the
            user stated it or it is needed to disambiguate the item. Otherwise omit
            this field. Do not use it for multiple artists.
          selector:
            text:
              multiline: true
        album_prompt:
          name: Album guidance
          default: >-
            Optional. For a track request, return the album only when the user stated
            it or it is needed to disambiguate the track. Otherwise omit this field.
          selector:
            text:
              multiline: true
        media_description_prompt:
          name: Media description guidance
          default: >-
            Optional. A short, natural-language description of only the requested
            media, suitable for a spoken confirmation. Exclude commands and playback
            targets. Example: for "shuffle the best Queen songs in the kitchen",
            return "the best Queen songs".
          selector:
            text:
              multiline: true
        area_prompt:
          name: Area guidance
          default: >-
            Optional list of Home Assistant area IDs. Use only areas explicitly named
            by the user or supplied as the voice satellite's current area by the
            conversation context. Omit when no area is known. Never guess. If the user
            names a specific player rather than a room, use media_player instead.
          selector:
            text:
              multiline: true
        media_player_prompt:
          name: Player guidance
          default: >-
            Optional list of Music Assistant media_player entity IDs. Use only players
            explicitly named by the user. Prefer exact entity IDs exposed by Home
            Assistant; a friendly name is acceptable if an ID is unavailable. Omit
            this field for room-only requests. Use both area and media_player only
            when the user explicitly requests both destinations.
          selector:
            text:
              multiline: true
        shuffle_prompt:
          name: Shuffle guidance
          default: >-
            Optional boolean. Set true only if the user explicitly asks to shuffle or
            randomize this request. Set false for normal play requests. Do not infer
            shuffle from words such as mix, variety, radio, mood, or playlist.
          selector:
            text:
              multiline: true

    extra_actions_section:
      name: Additional actions
      icon: mdi:wrench
      collapsed: true
      input:
        extra_actions:
          name: Actions after playback setup
          description: >-
            Optional actions run after playback and shuffle handling. Available
            variables include media_items, media_type_normalized, artist_clean,
            album_clean, media_description_clean, resolved_players, target_data,
            shuffle_requested, and radio_mode_value.
          default: []
          selector:
            action:

mode: parallel
max: 10
max_exceeded: warning
description: >-
  Play music with Music Assistant from an LLM voice request. Requires media_type
  and media_id; accepts optional artist, album, area, media_player, and shuffle.

fields:
  media_type:
    name: Media type
    description: !input media_type_prompt
    required: true
    selector:
      select:
        options:
          - track
          - album
          - artist
          - playlist
          - radio
  media_id:
    name: Media ID
    description: !input media_id_prompt
    required: true
    selector:
      text:
  artist:
    name: Artist
    description: !input artist_prompt
    required: false
    selector:
      text:
  album:
    name: Album
    description: !input album_prompt
    required: false
    selector:
      text:
  media_description:
    name: Media description
    description: !input media_description_prompt
    required: false
    selector:
      text:
  area:
    name: Area
    description: !input area_prompt
    required: false
    selector:
      area:
        entity:
          integration: music_assistant
          domain: media_player
        multiple: true
  media_player:
    name: Music Assistant player
    description: !input media_player_prompt
    required: false
    selector:
      entity:
        filter:
          - integration: music_assistant
            domain: media_player
        multiple: true
  shuffle:
    name: Shuffle
    description: !input shuffle_prompt
    required: false
    default: false
    selector:
      boolean:

sequence:
  - alias: Normalize configuration and request values
    variables:
      blueprint_version: 20260804
      configured_default_player: !input default_player
      enqueue_mode_value: !input enqueue_mode
      play_continuously_value: !input play_continuously
      manage_shuffle_value: !input manage_shuffle
      media_type_normalized: >-
        {{ media_type | default('', true) | string | trim | lower }}
      artist_clean: >-
        {{ artist | default('', true) | string | trim }}
      album_clean: >-
        {{ album | default('', true) | string | trim }}
      media_description_clean: >-
        {{ media_description | default('', true) | string | trim }}
      shuffle_requested: >-
        {{ shuffle | default(false, true) | bool(false) }}
      requested_player_refs: >-
        {% set value = media_player | default([], true) %}
        {{ [value] if value is string else value | list }}
      requested_area_refs: >-
        {% set value = area | default([], true) %}
        {{ [value] if value is string else value | list }}
      media_items: >-
        {% set value = media_id | default([], true) %}
        {% set ns = namespace(items=[]) %}
        {% if value is string %}
          {% for item in value.split(';') %}
            {% if item | trim %}
              {% set ns.items = ns.items + [item | trim] %}
            {% endif %}
          {% endfor %}
        {% elif value is iterable %}
          {% for item in value %}
            {% if item | string | trim %}
              {% set ns.items = ns.items + [item | string | trim] %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {{ ns.items }}

  - alias: Reject an invalid media request
    if:
      - condition: template
        value_template: >-
          {{ media_type_normalized not in ['track', 'album', 'artist', 'playlist', 'radio']
             or media_items | count == 0 }}
    then:
      - variables:
          result:
            status: error
            response: >-
              {% if media_items | count == 0 %}
                I need the name of the music, playlist, or station to play.
              {% else %}
                I couldn't determine whether that is a track, album, artist,
                playlist, or radio station.
              {% endif %}
      - stop: Invalid Music Assistant media request
        response_variable: result

  - alias: Discover Music Assistant player entities
    variables:
      music_assistant_players: >-
        {% set ns = namespace(players=[]) %}
        {% for entity in integration_entities('music_assistant') %}
          {% if entity.startswith('media_player.') %}
            {% set ns.players = ns.players + [entity] %}
          {% endif %}
        {% endfor %}
        {{ ns.players | unique | list }}

  - alias: Resolve explicitly requested player names and IDs
    variables:
      resolved_named_players: >-
        {% set ns = namespace(players=[]) %}
        {% for reference in requested_player_refs %}
          {% set wanted = reference | string | trim | lower %}
          {% for entity in music_assistant_players %}
            {% set friendly = state_attr(entity, 'friendly_name') | default('', true) | string | trim | lower %}
            {% if wanted and (wanted == entity | lower or wanted == friendly) %}
              {% set ns.players = ns.players + [entity] %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {{ ns.players | unique | list }}
      resolved_areas: >-
        {% set known = areas() %}
        {% set ns = namespace(area_ids=[]) %}
        {% for reference in requested_area_refs %}
          {% set value = reference | string | trim %}
          {% set resolved = value if value in known else area_id(value) %}
          {% if resolved and resolved in known %}
            {% set ns.area_ids = ns.area_ids + [resolved] %}
          {% endif %}
        {% endfor %}
        {{ ns.area_ids | unique | list }}

  - alias: Resolve Music Assistant players belonging to requested areas
    variables:
      resolved_area_players: >-
        {% set ns = namespace(players=[]) %}
        {% for area_id_value in resolved_areas %}
          {% for entity in area_entities(area_id_value) %}
            {% if entity in music_assistant_players %}
              {% set ns.players = ns.players + [entity] %}
            {% endif %}
          {% endfor %}
        {% endfor %}
        {{ ns.players | unique | list }}
      explicit_target_supplied: >-
        {{ requested_player_refs | count > 0 or requested_area_refs | count > 0 }}

  - alias: Apply safe target precedence
    variables:
      valid_default_player: >-
        {% set player = configured_default_player | default('', true) | string | trim %}
        {{ player if player in music_assistant_players else '' }}
      resolved_explicit_players: >-
        {{ (resolved_named_players + resolved_area_players) | unique | list }}
      resolved_players: >-
        {% if explicit_target_supplied %}
          {{ resolved_explicit_players }}
        {% elif valid_default_player %}
          {{ [valid_default_player] }}
        {% else %}
          {{ [] }}
        {% endif %}
      target_data: >-
        {{ {'entity_id': resolved_players} }}

  - alias: Ask for a usable playback target when resolution failed
    if:
      - condition: template
        value_template: "{{ resolved_players | count == 0 }}"
    then:
      - variables:
          result:
            status: error
            response: >-
              {% if explicit_target_supplied %}
                I couldn't find a Music Assistant player for that room or speaker.
                Please name another room or speaker.
              {% else %}
                Where should I play it? Please name a room or speaker.
              {% endif %}
      - stop: No valid Music Assistant target resolved
        response_variable: result

  - alias: Build documented Music Assistant play_media data
    variables:
      radio_mode_value: >-
        {% if media_type_normalized == 'radio' or play_continuously_value == 'Use player settings' %}
          omit
        {% elif play_continuously_value == 'Always' %}
          true
        {% else %}
          false
        {% endif %}
      action_data:
        media_id: >-
          {{ media_items[0] if media_items | count == 1 else media_items }}
        media_type: "{{ media_type_normalized }}"
        artist: >-
          {{ artist_clean if artist_clean and media_type_normalized in ['track', 'album'] else 'omit' }}
        album: >-
          {{ album_clean if album_clean and media_type_normalized == 'track' else 'omit' }}
        enqueue: "{{ enqueue_mode_value }}"
        radio_mode: "{{ radio_mode_value }}"
      play_data: >-
        {{ dict(action_data.items() | rejectattr('1', 'eq', 'omit')) }}

  - alias: Start playback through Music Assistant
    action: music_assistant.play_media
    target: "{{ target_data }}"
    data: "{{ play_data }}"

  - alias: Apply shuffle without making playback fail
    if:
      - condition: template
        value_template: "{{ manage_shuffle_value | bool(false) }}"
    then:
      - action: media_player.shuffle_set
        continue_on_error: true
        target: "{{ target_data }}"
        data:
          shuffle: "{{ shuffle_requested }}"

  - alias: Run configured post-playback actions
    sequence: !input extra_actions

  - alias: Return a concise result to the conversation agent
    variables:
      result:
        status: success
        response: >-
          Started {{ media_description_clean if media_description_clean else media_items | join(', ') }}
          on {{ resolved_players | map('state_attr', 'friendly_name') | reject('eq', none) | join(', ') }}.
        media_type: "{{ media_type_normalized }}"
        media_id: "{{ media_items }}"
        players: "{{ resolved_players }}"
        shuffle: "{{ shuffle_requested }}"
  - stop: Music Assistant playback request completed
    response_variable: result
